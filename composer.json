{
    "name": "kachnitel/entity-expression-language",
    "description": "Evaluates Symfony ExpressionLanguage strings against PHP objects, resolving properties via PropertyAccess with optional is_granted() support",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "symfony",
        "expression-language",
        "property-access",
        "security"
    ],
    "authors": [
        {
            "name": "Ondrej Vana",
            "email": "kachnitel@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/expression-language": "^6.4|^7.0|^8.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/security-core": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kachnitel\\EntityExpressionLanguage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kachnitel\\EntityExpressionLanguage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": ["@phpstan", "@phpunit"],
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpunit": "phpunit"
    }
}
